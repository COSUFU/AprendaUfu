{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ai-guard.mjs",
            "timeout": 10,
            "statusMessage": "Verificando guardrails de seguranca..."
          }
        ]
      }
    ]
  }
}
