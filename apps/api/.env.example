# Porta HTTP em que a API sobe. Padrao 3001 (o frontend espera a API nesta porta).
PORT=3001

# URL do frontend (web). Usada no CORS e como destino dos redirects do OAuth
# (callback de sucesso -> ${WEB_URL}/auth/callback; erro -> ${WEB_URL}/login?error=oauth).
WEB_URL=http://localhost:3000

# String de conexao do PostgreSQL. Formato:
# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Usada pela API (Prisma) e pelos comandos de migration.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/aprendaufu?schema=public

# Segredo usado para assinar/verificar os JWT de sessao. Use uma string aleatoria longa.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Client ID do OAuth do Google (Google Cloud Console -> Credentials -> OAuth client ID).
GOOGLE_CLIENT_ID=

# Client secret do mesmo OAuth client. Sigiloso: nunca commitar o valor real.
GOOGLE_CLIENT_SECRET=

# URI de redirecionamento do OAuth. Deve ser IDENTICA a cadastrada no Google Cloud Console
# em "Authorized redirect URIs", senao o Google recusa o login com redirect_uri_mismatch.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
